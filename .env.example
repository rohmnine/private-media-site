# ─────────────────────────────────────────────────────────────
# 私人媒体站 / Private Media Hub —— 环境变量模板
# 用法（推荐）：在项目根目录执行 `npm run init`，自动生成 .env 与随机强口令。
# 用法（手动）：把本文件复制为 .env，填入你自己的强口令后启动。
#   cp .env.example .env
# 注意：未创建 .env（或缺少任一必填项）时，服务会直接拒绝启动，
#       不会回退到任何默认口令。本文件全部为占位符，零明文口令。
# ─────────────────────────────────────────────────────────────

# 1) 访问密码（必填）：整站登录入口。至少 8 位，四个密码必须互不相同。
MEDIA_HUB_PASSWORD=CHANGE_ME_ACCESS_PASSWORD
# 2) 查看密码（必填）：单独解锁加密相册 / 加密图书馆展区。
MEDIA_HUB_VIEW_PASSWORD=CHANGE_ME_VIEW_PASSWORD
# 3) 管理员密码（必填）：解锁备份、恢复、导出、彻底删除等管理操作。
MEDIA_HUB_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# 4) 日记密码（必填）：单独解锁私人日记。
MEDIA_HUB_DIARY_PASSWORD=CHANGE_ME_DIARY_PASSWORD

# 会话签名密钥（必填，至少 32 位）。用 `openssl rand -hex 32` 生成，切勿使用示例值。
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# 仅当通过 HTTPS 访问时设为 true，让会话 Cookie 带上 Secure 标记。
COOKIE_SECURE=false

# 服务端口。
PORT=8080

# 站点名称（可选）：显示在页面标题与页头。不填则使用默认「私人媒体站」。
SITE_NAME=私人媒体站

# 单次上传体积上限（字节），默认 8 GiB。
MEDIA_HUB_MAX_UPLOAD_BYTES=8589934592
# 废弃区保留天数，0 表示关闭自动清理。
MEDIA_HUB_TRASH_RETENTION_DAYS=30

# 媒体 / 数据目录（默认相对项目根目录）。
MEDIA_ROOT=./assets
DATA_ROOT=./data
TRASH_ROOT=./trash
THUMB_ROOT=./thumbnails

# 可选：当需要把媒体库放到项目目录之外（数据盘 / NAS）时，
# 在此声明允许的外部根目录白名单，多个根目录用 ; 分隔。
# 留空（或注释掉）表示只允许项目目录内的路径，防止误把系统目录当作媒体库暴露。
# MEDIA_HUB_EXTRA_ROOTS=/mnt/media-hub

# ─────────────────────────────────────────────────────────────
# 内网宽松模式（可选，默认关闭）
# 仅在本机 / 可信局域网使用、不打算暴露到公网时，可设为 true：
# 密码允许短至 6 位、允许纯数字，方便记忆。
# 注意：常见弱口令（123456、111111、qwerty 等）仍会被拒绝；
#       公网环境请勿开启。
# MEDIA_HUB_LAN_MODE=false
